# Local development without Docker. Copy to apps/api/.env
NODE_ENV=development
PORT=4000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=carebridge
DB_USER=carebridge
DB_PASSWORD=change-me
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
