# Local development without Docker. Copy to apps/api/.env
NODE_ENV=development
PORT=4000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=carebridge
DB_USER=carebridge
DB_PASSWORD=change-me
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# Notifications — see docs/notifications.md
NOTIFY_SMS_PROVIDER=log          # log | termii | none
NOTIFY_EMAIL_PROVIDER=log        # log | smtp | none
# TERMII_API_KEY=
# TERMII_BASE_URL=https://<your-account-base-url>
# TERMII_SENDER_ID=CareLynk
# TERMII_CHANNEL=dnd
# SMTP_URL=smtps://user:password@smtp.example.com:465
EMAIL_FROM=CareLynk <no-reply@carebridge.local>
APP_URL=http://localhost:3000
WORKER_POLL_MS=5000
# Requests per IP per 15 min across /api (sign-in has its own limit of 20)
API_RATE_LIMIT_PER_15_MIN=1000
