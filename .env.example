# Used by docker-compose. Copy to .env and replace every secret.
NODE_ENV=production
PORT=4000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
DB_NAME=carebridge
DB_USER=carebridge
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
